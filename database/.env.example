DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_AUTO_MIGRATE=false

# Leave blank in local development for a random secret per server start.
# Production requires a long, random secret.
JWT_SECRET=
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
AI_SERVICE_URL=http://127.0.0.1:6000
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
